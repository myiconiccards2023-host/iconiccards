# Server Environment Configuration
PORT=3000
NODE_ENV=development

# Admin Access Passcode
ADMIN_PASSWORD=admin123

# Default Shipping Fee (in PHP or currency unit)
DEFAULT_SHIPPING_FEE=100

# Store Settings
STORE_NAME="Order Now - Batch Drop"
PAYMENT_INSTRUCTIONS="GCash: 0917-123-4567 (Juan Dela Cruz)\nBank: BDO 0012-3456-7890 (Juan Dela Cruz)"

# Optional: Supabase for Production Free-tier Deployment
# Leave empty to use built-in local SQLite database and local upload storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=order-now-assets

# Optional: Real-time Google Sheets Webhook URL
# Enter your Google Apps Script Web App URL to push every order automatically to Google Sheets
GOOGLE_SHEETS_WEBHOOK_URL=
